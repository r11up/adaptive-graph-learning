# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Outputs. Per-fold metrics and figures ARE published, so the numbers in the
# paper can be checked without re-running anything. The encoded-cohort caches
# are not: they are ~535 MB, regenerable in minutes, and derived from cohort
# data we are not permitted to redistribute.
*.pt
*.ckpt
results/**/*.pt

# Data — keep the directory, not its contents
data/*
!data/.gitkeep

# Source specification documents are deliberately NOT tracked: publishing
# them would disclose the full filing. Keep them local.
*.pdf

# Original exploratory notebook, superseded by src/qagta and
# examples/walkthrough.ipynb. Kept locally, not published.
QAE_*.ipynb

# OS
.DS_Store



# Manuscript sources — unpublished, kept local
paper-tex/



# LaTeX build artefacts
paper-tex/*.aux
paper-tex/*.log
paper-tex/*.out
paper-tex/*.synctex.gz
paper-tex/*.fls
paper-tex/*.fdb_latexmk
paper-tex/main.pdf

# Cohort data is governed by data use agreements (ABIDE, ADHD-200,
# REST-meta-MDD, UCLA-CNP) and is never redistributed here. Only derived
# per-fold metrics are published, which contain no subject identifiers.
